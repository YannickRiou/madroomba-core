[Unit]
Description=MadRoomba daemon (Roomba + lidar mapping)
After=network.target

[Service]
ExecStart=/home/pi/madroombad -roomba-port /dev/serial0 -listen :80 -base-url http://madserver:8081 -battery-mah 12800 -lidar-yaw 180
Restart=on-failure
RestartSec=5
User=pi
# Port 80 (http://madroomba.local) without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Serial ports + sysfs GPIO for the BRC wake-up pin
SupplementaryGroups=dialout gpio

[Install]
WantedBy=multi-user.target
