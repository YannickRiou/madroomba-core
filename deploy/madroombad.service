[Unit]
Description=MadRoomba daemon (Roomba + lidar mapping)
After=network.target

[Service]
ExecStart=/home/pi/madroombad -roomba-port /dev/serial0 -lidar-port /dev/ttyUSB0 -listen :8080
Restart=on-failure
RestartSec=5
User=pi
# Serial ports + sysfs GPIO for the BRC wake-up pin
SupplementaryGroups=dialout gpio

[Install]
WantedBy=multi-user.target
